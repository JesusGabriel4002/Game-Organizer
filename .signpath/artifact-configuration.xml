<?xml version="1.0" encoding="utf-8"?>
<!-- Paste into SignPath: Project > Artifact Configurations. The workflow uploads a ZIP with the NSIS installer. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Game.Organizer_*_x64-setup.exe" product-name="Game Organizer" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
